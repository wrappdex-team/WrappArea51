# Hedera EVM / Prediction Markets Configuration
# Copy to .env.local or .env and fill values. NEVER commit real keys.

# For Hardhat deployment (server-side / admin only)
HEDERA_EVM_PRIVATE_KEY=0xYourEvmPrivateKeyForDeployerAndResolver
HEDERA_TESTNET_RPC=https://testnet.hashio.io/api
HEDERA_MAINNET_RPC=https://mainnet.hashio.io/api

# Deployed contract addresses (populated by deploy script)
PREDICTION_MARKET_FACTORY_ADDRESS_TESTNET=0x...
PREDICTION_MARKET_FACTORY_ADDRESS_MAINNET=0x...

# Treasury / Fee recipient (EVM address that receives creation + platform fees)
PREDICTION_TREASURY_ADDRESS=0xYourTreasuryEvmAddress

# Optional: for future oracle integration
RESOLUTION_ORACLE_ADDRESS=0x...

# ── DAO HCS (Hedera TESTNET) — KZN-20260828-04 ──────────────────────
# Operator/treasury KEYS live in Area 51 Supabase only. NEVER commit real keys.
# Per-proposal TopicCreate; do not set a shared topic id for create/vote.
DAO_HCS_NETWORK=testnet
DAO_HCS_OPERATOR_ID=0.0.9006979
DAO_HCS_TREASURY_ID=0.0.9006841
DAO_HCS_OPERATOR_KEY=
DAO_HCS_TREASURY_KEY=
# Unused leftover (topics are per-proposal). Empty is OK.
VITE_DAO_HCS_TOPIC_ID=

# Eligibility token IDs (Area 51 testnet copies). Do not hardcode mainnet-only.
# Leave 0.0.x until Kyle mints testnet FT/NFT. Fallback in code is mainnet IDs.
DAO_HBARH_TOKEN_ID=0.0.x
DAO_NFT_TOKEN_ID=0.0.x
DAO_MIRROR_NETWORK=testnet
VITE_DAO_HBARH_TOKEN_ID=0.0.x
VITE_DAO_NFT_TOKEN_ID=0.0.x
